# ---- ارسال ایمیل با سرویس Resend (https://resend.com) ----
# یک کپی از این فایل به نام .env.local بسازید و مقادیر را کامل کنید.

# ۱. API Key را از داشبورد Resend بگیرید: https://resend.com/api-keys
RESEND_API_KEY=

# ۲. فرستنده: باید دامنه یا آدرسی باشد که در Resend تأیید (Verified) کرده‌اید
RESEND_FROM=سازه افزار فتح <info@sazehafzar.com>

# ۳. گیرنده درخواست‌های استخدامی (پیش‌فرض)
RESEND_TO=yeknazar.rayno@gmail.com

# ---- ربات تلگرام (ارسال درخواست‌ها به تلگرام) ----
# توکن را از @BotFather در تلگرام بگیرید
TELEGRAM_BOT_TOKEN=
# شناسه عددی چت مقصد (گروه یا شخص) — راهنما در README
TELEGRAM_CHAT_ID=
# آدرس پایه API پیام‌رسان — برای بله: https://tapi.bale.ai | برای تلگرام: https://api.telegram.org (پیش‌فرض)
TELEGRAM_API_BASE=https://tapi.bale.ai
